{
  "manifest_version": 3,
  "name": "Pinpoint AI — Visual Feedback for AI Pair Programmers",
  "version": "1.0.0",
  "description": "Universal in-browser visual inspection and pinpoint feedback tool for web development with AI pair programmers (Claude, Cursor, ChatGPT, Antigravity, Copilot).",
  "permissions": [
    "storage",
    "clipboardWrite",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Pinpoint AI"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
