{
  "manifest_version": 3,
  "name": "VisualPatch — Visual Feedback for AI Pair Programmers",
  "version": "2.1.1",
  "description": "Universal in-browser visual inspection and feedback tool for web development with AI pair programmers (Claude, Cursor, ChatGPT, Windsurf, Copilot).",
  "permissions": [
    "storage",
    "clipboardWrite",
    "activeTab",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": ["content.js"],
      "run_at": "document_end",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "VisualPatch"
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
